<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Chroni" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/chroni_paper</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
    </style>

    <!-- Écran de lancement : fond bleu nuit et icône Chroni. -->
    <style name="Theme.Chroni.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/chroni_night</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/chroni_night</item>
        <item name="postSplashScreenTheme">@style/Theme.Chroni</item>
    </style>
</resources>
